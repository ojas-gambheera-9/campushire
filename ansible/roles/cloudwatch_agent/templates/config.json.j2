{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/containers/campushire-api*.log", "log_group_name": "{{ app_log_group }}", "log_stream_name": "{instance_id}/{file_name}", "timezone": "UTC" },
          { "file_path": "/var/log/syslog", "log_group_name": "{{ system_log_group }}", "log_stream_name": "{instance_id}/syslog" },
          { "file_path": "/var/log/k3s*.log", "log_group_name": "{{ system_log_group }}", "log_stream_name": "{instance_id}/k3s" }
        ]
      }
    }
  }
}
